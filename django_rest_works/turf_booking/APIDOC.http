#api cal for create superuser
###
POST http://127.0.0.1:8000/v2/admin-user/
Content-Type: application/json

{
    "username":"superuser",
    "email":"superuser123@gmail.com",
    "password":"superuser"
}

#api cal for list
###
GET http://127.0.0.1:8000/v2/turf/
Accept: application/json
Authorization: Basic superuser:superuser
#api cal for create
###
POST http://127.0.0.1:8000/v2/turf/
Content-Type: application/json
Authorization: Basic superuser:superuser
{
    "name":"abhi",
    "location":"palakkad",
    "phone":1234567822,
    "fee":1200
}

#api cal for details
###
GET http://127.0.0.1:8000/v2/turf/3/
Accept: application/json
Authorization: Basic superuser:superuser
#api cal for update
###
PUT http://127.0.0.1:8000/v2/turf/3/
Content-Type: application/json
Authorization: Basic superuser:superuser
{
    "name":"abhinav",
    "location":"palakkad",
    "phone":1234567822,
    "fee":1500
}

#api cal for delete
###
DELETE http://127.0.0.1:8000/v2/turf/3/
Accept: application/json
Authorization: Basic superuser:superuser




