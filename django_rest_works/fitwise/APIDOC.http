Authorization: Token b4e26de113fda3c87fa0403ae3fe5bb0643f906d

{
    "title":"porota",
    "calories": 150,
    "meal_type":"DINNER",
    "serving_size":"180g"
}

#api cal for retrieve
###
GET http://127.0.0.1:8000/v1/fitwise/foodlog/2/ 
Accept: application/json
Authorization: Token b4e26de113fda3c87fa0403ae3fe5bb0643f906d


#api cal for update
###
PUT http://127.0.0.1:8000/v1/fitwise/foodlog/2/ 
