Authorization: Token b4e26de113fda3c87fa0403ae3fe5bb0643f906d
{
  "id": 2,
  "title": "salad",
  "calories": 120,
  "meal_type": "SNACK",
  "serving_size": "200g",
  "created_at": "2026-10-11T15:18:23.506981Z",
  "owner": 1
}

